GROQ_API_KEY=
# optional overrides:
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_CLEANUP_MODEL=openai/gpt-oss-120b

# Reliability knobs (defaults shown):
# KOTODAMA_KEEP_AUDIO=1          keep source audio after a successful transcript
#                                (set 0 to delete on success; failures are ALWAYS kept)
# KOTODAMA_MAX_ATTEMPTS=3        attempts per API call before giving up
# KOTODAMA_TIMEOUT=25            seconds to wait on each Groq call
# KOTODAMA_SILENCE_THRESHOLD=400 peak amplitude below which a segment counts as silence
# KOTODAMA_TOKEN_RESERVE=1500    pause the queue when Groq reports fewer than this
#                                many cleanup tokens left in the current minute
# KOTODAMA_RATE_LIMIT_WAIT=60    on HTTP 429, stop everything and wait this many
#                                seconds (a full token window) before retrying
# KOTODAMA_RATE_LIMIT_ATTEMPTS=5 how many full-window waits to sit through before
#                                giving up (audio is kept either way)
